     pub fn get_next_active_panel(&mut self) -> Option<&Panel> {
+        // Wraparound must be based on how many entries are actually in the
+        // active rotation list (`mianban` / `active_panels`), not on the
+        // total number of *defined* panels (`panels.len()`, i.e. `diy`).
+        // The original code compared against `panels.len()`, which is wrong
+        // whenever the active list is shorter (advances past the last real
+        // entry with no match -> returns None -> caller treats it as fatal)
+        // or longer (resets before ever reaching entries past `panels.len()`
+        // -> silently unreachable/dead entries) than the total panel count.
+        let active_count = self.active_panels.iter().filter(|&&active| active > 0).count();
         let mut active_panel_idx = self.active_panel_idx.unwrap_or(0) + 1;
-        if active_panel_idx > self.panels.len() {
+        if active_panel_idx > active_count {
             active_panel_idx = 1;
         }
 
